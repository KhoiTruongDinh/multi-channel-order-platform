FROM python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c
WORKDIR /app
COPY requirements/m02.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --requirement /tmp/requirements.txt
COPY simulator/etsy_api.py /app/simulator/etsy_api.py
COPY simulator/s02_store.py /app/simulator/s02_store.py
COPY simulator/s02_temporal.py /app/simulator/s02_temporal.py
COPY simulator/live_source.py /app/simulator/live_source.py
COPY simulator/http_faults.py /app/simulator/http_faults.py
COPY fixtures/s01/source_states/etsy /fixtures/etsy
CMD ["python", "-m", "simulator.etsy_api"]
