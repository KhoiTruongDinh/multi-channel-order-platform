POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-bootstrap-only
POSTGRES_PORT=55432
WEBSITE_READER_PASSWORD=change-me
WEBSITE_WRITER_PASSWORD=change-me
MARKETPLACE_WRITER_PASSWORD=change-me
PLATFORM_INGEST_PASSWORD=change-me
PLATFORM_TRANSFORM_PASSWORD=change-me
PLATFORM_PUBLISHER_PASSWORD=change-me
PLATFORM_REPORT_PASSWORD=change-me
AIRFLOW_APP_PASSWORD=change-me
AIRFLOW_PORT=8080
AIRFLOW_UI_USERNAME=admin
# Empty preserves Airflow's generated password; set locally to provision a chosen one.
AIRFLOW_UI_PASSWORD=
# Polling DAGs are created paused. Set an explicit UTC bootstrap start before enabling.
WEBSITE_POLL_INTERVAL_SECONDS=300
EBAY_POLL_INTERVAL_SECONDS=300
WEBSITE_POLL_INITIAL_START=
EBAY_POLL_INITIAL_START=
POLL_OVERLAP_SECONDS=120
# Maintenance only: no new periodic runs; leave DAGs unpaused until retries finish.
POLLING_DRAIN_MODE=false
# Synthetic local simulator token only; never use marketplace production credentials.
EBAY_SIM_TOKEN=local-s01-test-token
EBAY_API_PORT=8081
EBAY_CONTROL_PORT=8091
# Synthetic local Etsy settings only; the receiver is independent of Airflow.
ETSY_SIM_TOKEN=local-s01-test-token
ETSY_SIGNING_SECRET=whsec_bG9jYWwtczAxLXRlc3Qtc2VjcmV0
ETSY_SHOP_ID=7001
ETSY_SUBSCRIPTION_ID=local-s01
ETSY_API_PORT=8082
ETSY_CONTROL_PORT=8092
ETSY_RECEIVER_PORT=8083
ETSY_FRESHNESS_SECONDS=300
ETSY_LEASE_SECONDS=60
ETSY_INBOX_INTERVAL_SECONDS=300
ETSY_RECOVERY_INTERVAL_SECONDS=300
ETSY_RECOVERY_INITIAL_START=
